name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  contracts:
    name: Contracts
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive
      - uses: foundry-rs/foundry-toolchain@v1
      - name: Install dependencies
        run: make install
      - name: Format
        run: forge fmt --check
        continue-on-error: true
      - name: Build
        run: forge build --sizes
      - name: Test
        run: FOUNDRY_PROFILE=ci forge test -vv

  sdk:
    name: SDK
    runs-on: ubuntu-latest
    needs: contracts
    steps:
      - uses: actions/checkout@v4
      - uses: foundry-rs/foundry-toolchain@v1
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - run: make install && forge build
      - working-directory: sdk
        run: npm install && npm run abis && npm run typecheck && npm test
